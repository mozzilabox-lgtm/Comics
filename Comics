<!DOCTYPE html>
<html>
<head>
  <title>Comic Reader Online</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <style>
    body {
      margin:0;
      font-family:sans-serif;
      background:#111;
      color:white;
      text-align:center;
    }

    input {
      margin:20px;
    }

    img {
      max-width:100%;
      max-height:80vh;
    }

    button {
      padding:10px;
      margin:10px;
    }
  </style>
</head>

<body>

<h1>📚 Comic Reader</h1>

<input type="file" id="fileInput" accept=".cbz,.zip,.pdf">

<div id="viewer"></div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>

<script>
let pages = []
let index = 0

const viewer = document.getElementById('viewer')

document.getElementById('fileInput').onchange = async (e) => {
  const file = e.target.files[0]

  if (file.name.endsWith('.cbz') || file.name.endsWith('.zip')) {
    const zip = await JSZip.loadAsync(file)
    pages = []

    for (let name in zip.files) {
      if (name.match(/\.(jpg|png|jpeg)/)) {
        const blob = await zip.files[name].async('blob')
        pages.push(URL.createObjectURL(blob))
      }
    }

    index = 0
    render()
  }

  else {
    alert("Пока поддержка только CBZ/ZIP (онлайн версия)")
  }
}

function render() {
  viewer.innerHTML = `
    <img src="${pages[index]}">
    <div>
      <button onclick="prev()">⬅</button>
      <button onclick="next()">➡</button>
    </div>
  `
}

function next() {
  if (index < pages.length - 1) {
    index++
    render()
  }
}

function prev() {
  if (index > 0) {
    index--
    render()
  }
}
</script>

</body>
</html>
